generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum WalletStatus {
  ACTIVE @map("active")
  FROZEN @map("frozen")
  CLOSED @map("closed")

  @@map("wallet_status")
}

enum LedgerAccountType {
  WALLET          @map("wallet")
  SYSTEM_CLEARING @map("system_clearing")

  @@map("ledger_account_type")
}

enum LedgerTransactionType {
  OPENING_FUNDING @map("opening_funding")
  TRANSFER        @map("transfer")
  ADJUSTMENT      @map("adjustment")
  REVERSAL        @map("reversal")

  @@map("ledger_transaction_type")
}

enum LedgerTransactionStatus {
  PENDING @map("pending")
  POSTED  @map("posted")
  VOIDED  @map("voided")

  @@map("ledger_transaction_status")
}

enum TransferStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")
  FAILED    @map("failed")
  REVERSED  @map("reversed")

  @@map("transfer_status")
}

enum IdempotencyStatus {
  PROCESSING @map("processing")
  COMPLETED  @map("completed")
  FAILED     @map("failed")

  @@map("idempotency_status")
}

enum AuditOutcome {
  SUCCEEDED @map("succeeded")
  REJECTED  @map("rejected")

  @@map("audit_outcome")
}

enum OutboxStatus {
  PENDING   @map("pending")
  CLAIMED   @map("claimed")
  PUBLISHED @map("published")
  DEAD_LETTER @map("dead_letter")

  @@map("outbox_status")
}

enum NotificationStatus {
  RECORDED @map("recorded")

  @@map("notification_status")
}

enum UserRole {
  CUSTOMER   @map("customer")
  OPERATIONS @map("operations")
  ADMIN      @map("admin")

  @@map("user_role")
}

enum UserStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")

  @@map("user_status")
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(254)
  passwordHash String?       @map("password_hash") @db.VarChar(255)
  role         UserRole      @default(CUSTOMER)
  status       UserStatus    @default(SUSPENDED)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  wallets      Wallet[]
  sessions     AuthSession[]
  notifications TransactionNotification[]

  @@index([status, role])
  @@map("users")
}

model AuthSession {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime       @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime?      @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt DateTime?      @map("last_used_at") @db.Timestamptz(6)
  user       User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokens     RefreshToken[]

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id            String        @id @default(uuid()) @db.Uuid
  sessionId     String        @map("session_id") @db.Uuid
  tokenHash     String        @unique @map("token_hash") @db.Char(64)
  expiresAt     DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime?     @map("used_at") @db.Timestamptz(6)
  revokedAt     DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  parentTokenId String?       @unique @map("parent_token_id") @db.Uuid
  session       AuthSession   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  parentToken   RefreshToken? @relation("RefreshRotation", fields: [parentTokenId], references: [id], onDelete: Restrict)
  childToken    RefreshToken? @relation("RefreshRotation")

  @@index([sessionId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Wallet {
  id                   String         @id @default(uuid()) @db.Uuid
  userId               String         @map("user_id") @db.Uuid
  ownerReference       String         @unique @map("owner_reference") @db.VarChar(100)
  currency             String         @default("NGN") @db.Char(3)
  status               WalletStatus   @default(ACTIVE)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerAccount        LedgerAccount?
  outgoingTransfers    Transfer[]     @relation("TransferSourceWallet")
  destinationTransfers Transfer[]     @relation("TransferDestinationWallet")

  @@index([status])
  @@index([userId])
  @@map("wallets")
}

model LedgerAccount {
  id                 String            @id @default(uuid()) @db.Uuid
  walletId           String?           @unique @map("wallet_id") @db.Uuid
  code               String            @unique @db.VarChar(100)
  name               String            @db.VarChar(200)
  type               LedgerAccountType
  currency           String            @db.Char(3)
  cachedBalanceMinor BigInt            @default(0) @map("cached_balance_minor")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  wallet             Wallet?           @relation(fields: [walletId], references: [id], onDelete: Restrict)
  entries            LedgerEntry[]

  @@index([type, currency])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id                String                  @id @default(uuid()) @db.Uuid
  type              LedgerTransactionType
  status            LedgerTransactionStatus @default(PENDING)
  currency          String                  @db.Char(3)
  description       String?                 @db.VarChar(500)
  externalReference String?                 @unique @map("external_reference") @db.VarChar(255)
  reversalOfId      String?                 @unique @map("reversal_of_id") @db.Uuid
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  postedAt          DateTime?               @map("posted_at") @db.Timestamptz(6)
  reversalOf        LedgerTransaction?      @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy        LedgerTransaction?      @relation("JournalReversal")
  entries           LedgerEntry[]
  transfer          Transfer?

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String            @id @default(uuid()) @db.Uuid
  transactionId String            @map("transaction_id") @db.Uuid
  accountId     String            @map("account_id") @db.Uuid
  amountMinor   BigInt            @map("amount_minor")
  description   String?           @db.VarChar(500)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account       LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId, createdAt])
  @@map("ledger_entries")
}

model Transfer {
  id                  String             @id @default(uuid()) @db.Uuid
  sourceWalletId      String             @map("source_wallet_id") @db.Uuid
  destinationWalletId String             @map("destination_wallet_id") @db.Uuid
  ledgerTransactionId String?            @unique @map("ledger_transaction_id") @db.Uuid
  idempotencyRecordId String?            @unique @map("idempotency_record_id") @db.Uuid
  amountMinor         BigInt             @map("amount_minor")
  currency            String             @db.Char(3)
  status              TransferStatus     @default(PENDING)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt         DateTime?          @map("completed_at") @db.Timestamptz(6)
  sourceWallet        Wallet             @relation("TransferSourceWallet", fields: [sourceWalletId], references: [id], onDelete: Restrict)
  destinationWallet   Wallet             @relation("TransferDestinationWallet", fields: [destinationWalletId], references: [id], onDelete: Restrict)
  ledgerTransaction   LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  idempotencyRecord   IdempotencyRecord? @relation(fields: [idempotencyRecordId], references: [id], onDelete: Restrict)
  notifications       TransactionNotification[]

  @@index([status, createdAt])
  @@index([sourceWalletId, createdAt])
  @@index([destinationWalletId, createdAt])
  @@map("transfers")
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  scope          String            @db.VarChar(100)
  key            String            @db.VarChar(255)
  requestHash    String            @map("request_hash") @db.Char(64)
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  expiresAt      DateTime?         @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  transfer       Transfer?

  @@unique([scope, key])
  @@index([status, createdAt])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AuditEvent {
  id         String       @id @default(uuid()) @db.Uuid
  entityType String       @map("entity_type") @db.VarChar(100)
  entityId   String       @map("entity_id") @db.Uuid
  action     String       @db.VarChar(100)
  outcome    AuditOutcome @default(SUCCEEDED)
  actorType  String?      @map("actor_type") @db.VarChar(100)
  actorId    String?      @map("actor_id") @db.VarChar(255)
  metadata   Json?
  occurredAt DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([entityType, entityId, occurredAt])
  @@index([occurredAt])
  @@map("audit_events")
}

model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  eventType      String       @map("event_type") @db.VarChar(100)
  eventVersion   Int          @map("event_version")
  aggregateId    String       @map("aggregate_id") @db.Uuid
  aggregateType  String       @map("aggregate_type") @db.VarChar(100)
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz(6)
  nextAttemptAt  DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError      String?      @map("last_error") @db.VarChar(100)
  leaseOwner     String?      @map("lease_owner") @db.VarChar(100)
  leaseToken     String?      @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime?    @map("lease_expires_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  id           String                   @id @db.Uuid
  eventType    String                   @map("event_type") @db.VarChar(100)
  processedAt  DateTime                 @default(now()) @map("processed_at") @db.Timestamptz(6)
  notification TransactionNotification?

  @@index([processedAt])
  @@map("processed_events")
}

model TransactionNotification {
  id              String             @id @default(uuid()) @db.Uuid
  eventId         String             @unique @map("event_id") @db.Uuid
  recipientUserId String             @map("recipient_user_id") @db.Uuid
  transferId      String             @map("transfer_id") @db.Uuid
  eventType       String             @map("event_type") @db.VarChar(100)
  status          NotificationStatus @default(RECORDED)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  event           ProcessedEvent     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  recipient       User               @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  transfer        Transfer           @relation(fields: [transferId], references: [id], onDelete: Restrict)

  @@index([recipientUserId, createdAt])
  @@index([transferId])
  @@map("transaction_notifications")
}

model FailedBackgroundJob {
  id               String   @id @default(uuid()) @db.Uuid
  eventId          String   @map("event_id") @db.VarChar(100)
  jobId            String   @map("job_id") @db.VarChar(150)
  source           String   @db.VarChar(20)
  failureCategory  String   @map("failure_category") @db.VarChar(20)
  failureReason    String   @map("failure_reason") @db.VarChar(100)
  attempts         Int
  runAttempts      Int      @default(0) @map("run_attempts")
  firstFailureAt   DateTime @map("first_failure_at") @db.Timestamptz(6)
  lastFailureAt    DateTime @map("last_failure_at") @db.Timestamptz(6)
  status           String   @db.VarChar(20)
  retryActorId     String?  @map("retry_actor_id") @db.Uuid
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, lastFailureAt])
  @@index([eventId])
  @@unique([source, jobId])
  @@map("failed_background_jobs")
}
