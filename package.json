{
  "name": "ledgerflow",
  "version": "0.1.0",
  "private": true,
  "description": "LedgerFlow monorepo",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "npm run build --workspace @ledgerflow/api",
    "db:down": "docker compose down",
    "db:format": "npm run db:format --workspace @ledgerflow/api",
    "db:generate": "npm run db:generate --workspace @ledgerflow/api",
    "db:logs": "docker compose logs -f database",
    "db:migrate": "npm run db:migrate --workspace @ledgerflow/api --",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @ledgerflow/api",
    "db:seed": "npm run db:seed --workspace @ledgerflow/api",
    "db:status": "npm run db:status --workspace @ledgerflow/api",
    "db:up": "docker compose up -d database",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose stop redis",
    "db:validate": "npm run db:validate --workspace @ledgerflow/api",
    "phase4:up": "bash scripts/phase4/run.sh up",
    "phase4:down": "bash scripts/phase4/run.sh down",
    "phase4:reset": "bash scripts/phase4/run.sh reset",
    "phase4:migrate": "bash scripts/phase4/run.sh migrate",
    "phase4:seed": "bash scripts/phase4/run.sh seed",
    "phase4:baseline": "bash scripts/phase4/run.sh baseline",
    "phase4:e2e": "bash scripts/phase4/run.sh e2e",
    "phase4:openapi": "npm run build --workspace @ledgerflow/api && node scripts/phase4/export-openapi.cjs",
    "phase4:contract": "npm run phase4:openapi && node scripts/phase4/check-contracts.mjs && npm run phase4:matrix",
    "phase4:matrix": "node scripts/phase4/render-contract-matrix.mjs",
    "format": "npm run format --workspace @ledgerflow/api",
    "format:check": "npm run format:check --workspace @ledgerflow/api",
    "lint": "npm run lint --workspace @ledgerflow/api",
    "ledger:verify": "npm run ledger:verify --workspace @ledgerflow/api",
    "start": "npm run start --workspace @ledgerflow/api",
    "start:dev": "npm run start:dev --workspace @ledgerflow/api",
    "start:prod": "npm run start:prod --workspace @ledgerflow/api",
    "start:dispatcher": "npm run start:dispatcher --workspace @ledgerflow/api",
    "start:worker": "npm run start:worker --workspace @ledgerflow/api",
    "test": "npm run test --workspace @ledgerflow/api",
    "test:integration": "npm run test:integration --workspace @ledgerflow/api",
    "test:concurrency": "npm run test:concurrency --workspace @ledgerflow/api",
    "test:cov": "npm run test:cov --workspace @ledgerflow/api",
    "test:watch": "npm run test:watch --workspace @ledgerflow/api",
    "typecheck": "npm run typecheck --workspace @ledgerflow/api",
    "web:dev": "npm run dev --workspace @ledgerflow/web",
    "web:build": "npm run build --workspace @ledgerflow/web",
    "web:start": "npm run start --workspace @ledgerflow/web",
    "web:lint": "npm run lint --workspace @ledgerflow/web",
    "web:typecheck": "npm run typecheck --workspace @ledgerflow/web",
    "web:verify:ui": "npm run verify:ui --workspace @ledgerflow/web",
    "web:test:money": "npm run test:money --workspace @ledgerflow/web"
  },
  "devDependencies": {
    "shadcn": "^4.22.1"
  }
}
