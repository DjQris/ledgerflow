# Application
NODE_ENV=development
PORT=3000
SERVICE_NAME=ledgerflow-api

# Local PostgreSQL development database
POSTGRES_DB=ledgerflow
POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=ledgerflow_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ledgerflow:ledgerflow_dev_password@localhost:5432/ledgerflow?schema=public

# Authentication is unavailable until a private, random signing key of at least
# 32 bytes is configured in .env. Never commit that value.
AUTH_SIGNING_KEY=
AUTH_ISSUER=ledgerflow-api
AUTH_AUDIENCE=ledgerflow-client
AUTH_ALLOWED_ORIGIN=http://localhost:3000
AUTH_BCRYPT_ROUNDS=12
AUTH_COOKIE_SECURE=false
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
