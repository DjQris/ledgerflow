# Application
NODE_ENV=development
PORT=3000
SERVICE_NAME=ledgerflow-api

# Local PostgreSQL development database
POSTGRES_DB=ledgerflow
POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=ledgerflow_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ledgerflow:ledgerflow_dev_password@localhost:5432/ledgerflow?schema=public

# Reserved for a later authentication phase. Leave the signing key unset in 2A;
# generate and store a real key only in a private local environment when needed.
AUTH_SIGNING_KEY=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
